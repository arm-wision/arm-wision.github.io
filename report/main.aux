\BKM@entry{id=20,dest={73756273656374696F6E2E342E35},srcline={142}}{5C3337365C3337375C303030345C3030302E5C303030355C3030305C3034305C303030545C303030695C3030306C5C303030655C3030305C3034305C303030415C303030675C303030675C303030725C303030655C303030675C303030615C303030745C303030695C3030306F5C3030306E}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Unfrozen-blocks sweep within experiment~010 (BioCLIP~2.5 ViT-H/14, $1.41$M-image single-plant manifest; each stage warm-starts from the previous, block stages train five epochs). Public Macro F1 peaks at eight unfrozen blocks; the private split is flatter, with the four-, eight- and twelve-block runs within $0.006$ of one another ($0.383$--$0.389$), so the optimum is a moderate-unfreeze plateau rather than a single sharp peak. Held-out validation top-5 rises monotonically through twelve blocks: the validation/leaderboard decoupling of \S  \ref {sec:val_lb}. The full fine-tune was submitted but scored far below the plateau on both splits (public $0.301$, private $0.296$); its validation top-5 ($0.934$) had already dropped below the 12-block run and its validation loss rose after epoch~7 (overfitting), so we did not carry it forward. Each cell is the best-public or best-private selection for that stage; selection rules differ across cells.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:blocks}{{2}{10}{Unfrozen-blocks sweep within experiment~010 (BioCLIP~2.5 ViT-H/14, $1.41$M-image single-plant manifest; each stage warm-starts from the previous, block stages train five epochs). Public Macro F1 peaks at eight unfrozen blocks; the private split is flatter, with the four-, eight- and twelve-block runs within $0.006$ of one another ($0.383$--$0.389$), so the optimum is a moderate-unfreeze plateau rather than a single sharp peak. Held-out validation top-5 rises monotonically through twelve blocks: the validation/leaderboard decoupling of \S \ref {sec:val_lb}. The full fine-tune was submitted but scored far below the plateau on both splits (public $0.301$, private $0.296$); its validation top-5 ($0.934$) had already dropped below the 12-block run and its validation loss rose after epoch~7 (overfitting), so we did not carry it forward. Each cell is the best-public or best-private selection for that stage; selection rules differ across cells}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Unfrozen-blocks sweep visualised with both metrics. Held-out validation top-5 (dashed, right axis) rises monotonically with unfrozen depth ($n{=}0\rightarrow 12$), but leaderboard Macro F1 (solid, left axis) peaks at $n{=}8$ and declines by $n{=}12$; the full fine-tune ($n{=}32$) drops further still. The disagreement between the two curves is examined in \S  \ref {sec:val_lb}: validation accuracy on the single-plant distribution does not predict multi-species quadrat Macro F1.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:unfreeze_sweep}{{6}{10}{Unfrozen-blocks sweep visualised with both metrics. Held-out validation top-5 (dashed, right axis) rises monotonically with unfrozen depth ($n{=}0\rightarrow 12$), but leaderboard Macro F1 (solid, left axis) peaks at $n{=}8$ and declines by $n{=}12$; the full fine-tune ($n{=}32$) drops further still. The disagreement between the two curves is examined in \S \ref {sec:val_lb}: validation accuracy on the single-plant distribution does not predict multi-species quadrat Macro F1}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Tile Aggregation}{10}{subsection.4.5}\protected@file@percent }
\newlabel{sec:tile_aggregation}{{4.5}{10}{Tile Aggregation}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces i002 staged unfreeze sweep on the larger $2.65$M-image manifest (ten epochs per stage, three taxonomy heads). Unlike the 010 sweep, public Macro F1 peaks at \emph  {four} blocks and eight blocks is worse, so the four-block checkpoint was submitted; the larger manifest already makes the head-only baseline strong ($0.394$). This sweep is partial (no twelve-block or full-fine-tune run) and is \emph  {not} directly comparable to the 010 sweep, which differs in manifest, schedule and head topology. The bottom rows show the logit-adjustment and resolution-ensemble inference steps that produce the headline anchor (\S  \ref {sec:infer_ablations}).}}{11}{table.3}\protected@file@percent }
\newlabel{tab:blocks_i002}{{3}{11}{i002 staged unfreeze sweep on the larger $2.65$M-image manifest (ten epochs per stage, three taxonomy heads). Unlike the 010 sweep, public Macro F1 peaks at \emph {four} blocks and eight blocks is worse, so the four-block checkpoint was submitted; the larger manifest already makes the head-only baseline strong ($0.394$). This sweep is partial (no twelve-block or full-fine-tune run) and is \emph {not} directly comparable to the 010 sweep, which differs in manifest, schedule and head topology. The bottom rows show the logit-adjustment and resolution-ensemble inference steps that produce the headline anchor (\S \ref {sec:infer_ablations})}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Inference-time tile-aggregation rules. Aggregation maps the sixteen tile-level species predictions into one image-level score vector. Mean uses all tiles equally and dilutes evidence that is strong in only a few tiles; max keeps each species' single strongest tile and is sensitive to one over-confident tile; softmax-mean averages normalised per-tile probability votes, so evidence accumulates without any one tile dominating. Top-$k$ and probability-threshold selection are applied after aggregation and are not themselves aggregation rules.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:aggregation_definitions}{{7}{11}{Inference-time tile-aggregation rules. Aggregation maps the sixteen tile-level species predictions into one image-level score vector. Mean uses all tiles equally and dilutes evidence that is strong in only a few tiles; max keeps each species' single strongest tile and is sensitive to one over-confident tile; softmax-mean averages normalised per-tile probability votes, so evidence accumulates without any one tile dominating. Top-$k$ and probability-threshold selection are applied after aggregation and are not themselves aggregation rules}{figure.7}{}}
\BKM@entry{id=21,dest={73756273656374696F6E2E342E36},srcline={183}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Two-stage tile-aggregation comparison (public and private Macro F1). The left panel is the earlier experiment 010 head-only checkpoint at matched tile geometry (\texttt  {grid\_4x4}, overlap $0.5$), where plain mean was explored and found weakest, so it was dropped. The right panel is the final i002 four-block checkpoint (\texttt  {grid\_4x4}, no overlap, $224$ pixels), where the submitted comparison was max against softmax-mean only; plain mean is intentionally absent from this panel because it was not re-submitted on this checkpoint. Softmax-mean improves on max on both splits, and softmax-mean with logit adjustment ($\tau {=}0.25$) is the most robust on the private split. Each bar is the best-public or best-private selection for that mode.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:aggregation_results}{{8}{12}{Two-stage tile-aggregation comparison (public and private Macro F1). The left panel is the earlier experiment 010 head-only checkpoint at matched tile geometry (\texttt {grid\_4x4}, overlap $0.5$), where plain mean was explored and found weakest, so it was dropped. The right panel is the final i002 four-block checkpoint (\texttt {grid\_4x4}, no overlap, $224$ pixels), where the submitted comparison was max against softmax-mean only; plain mean is intentionally absent from this panel because it was not re-submitted on this checkpoint. Softmax-mean improves on max on both splits, and softmax-mean with logit adjustment ($\tau {=}0.25$) is the most robust on the private split. Each bar is the best-public or best-private selection for that mode}{figure.8}{}}
